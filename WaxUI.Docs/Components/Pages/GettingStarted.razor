@page "/getting-started"
@rendermode InteractiveServer

<PageTitle>Getting Started - WaxUI</PageTitle>

<div class="mb-8">
    <h1 class="text-3xl font-display font-bold text-foreground mb-2">Getting Started</h1>
    <p class="text-muted-foreground">Install and configure WaxUI in your Blazor project.</p>
</div>

<div class="space-y-8">

    <div class="p-6 rounded-3xl bg-card border border-border">
        <h2 class="font-semibold text-foreground mb-1">Installation</h2>
        <p class="text-sm text-muted-foreground mb-4">Add the NuGet package to your project.</p>
        <pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>dotnet add package WaxUI</code></pre>
    </div>

    <div class="p-6 rounded-3xl bg-card border border-border">
        <h2 class="font-semibold text-foreground mb-1">Register Services</h2>
        <p class="text-sm text-muted-foreground mb-4">Add WaxUI to the service collection in <code class="bg-muted px-1 rounded">Program.cs</code>.</p>
        <pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>builder.Services.AddWaxUI();</code></pre>
    </div>

    <div class="p-6 rounded-3xl bg-card border border-border">
        <h2 class="font-semibold text-foreground mb-1">Load Styles</h2>
        <p class="text-sm text-muted-foreground mb-4">
            WaxUI uses Khamsin for utility CSS. Add Khamsin to projects that write utility
            classes, then link the generated stylesheet. Blazor Server apps can serve it with
            <code class="bg-muted px-1 rounded">app.MapKhamsinCss()</code> instead.
        </p>
        <pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>dotnet add package Khamsin --version 0.3.0</code></pre>
        <pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm mt-3"><code>@@* App.razor *@@
&lt;link rel="stylesheet" href="khamsin.css" /&gt;</code></pre>
    </div>

    <div class="p-6 rounded-3xl bg-card border border-border">
        <h2 class="font-semibold text-foreground mb-1">Add Imports</h2>
        <p class="text-sm text-muted-foreground mb-4">Add the following to your <code class="bg-muted px-1 rounded">_Imports.razor</code>.</p>
        <pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>@@using WaxUI
@@using WaxUI.Theme
@@using WaxUI.Services.Theme
@@using WaxUI.Button
@@using WaxUI.Card
@@using WaxUI.Badge
@@using WaxUI.Switch
@@using WaxUI.TextField
@@using WaxUI.Checkbox
@@using WaxUI.Radio
@@using WaxUI.Tabs
@@using WaxUI.Accordion
@@using WaxUI.Avatar
@@using WaxUI.Chip
@@using WaxUI.Fab
@@using WaxUI.Progress
@@using WaxUI.QrCode
@@using WaxUI.Slider
@@using WaxUI.Spoiler
@@using WaxUI.Navigation
@@using WaxUI.Popover</code></pre>
    </div>

    <div class="p-6 rounded-3xl bg-card border border-border">
        <h2 class="font-semibold text-foreground mb-1">Include Theme Support</h2>
        <p class="text-sm text-muted-foreground mb-4">Add <code class="bg-muted px-1 rounded">FontMap.razor</code> and <code class="bg-muted px-1 rounded">ThemePreloader.razor</code> to your root layout, and render the theme class on <code class="bg-muted px-1 rounded">&lt;html&gt;</code> from the <code class="bg-muted px-1 rounded">wax-theme</code> cookie (via <code class="bg-muted px-1 rounded">ThemeCookie</code>). Without the SSR class, Blazor's enhanced navigation replays a classless <code class="bg-muted px-1 rounded">&lt;html&gt;</code> and the theme flashes on every page change.</p>
        <pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>@@* App.razor *@@
@@inject IHttpContextAccessor HttpContextAccessor

&lt;html lang="en" class="@@ThemeClassAttr"&gt;
    &lt;HeadOutlet /&gt;
    &lt;FontMap /&gt;
    &lt;ThemePreloader /&gt;
    &lt;Routes /&gt;

@@code {
    private string? ThemeClassAttr =&gt;
        ThemeCookie.ReadThemeClass(HttpContextAccessor.HttpContext);
}</code></pre>
        <p class="text-sm text-muted-foreground mt-3">Register the accessor in <code class="bg-muted px-1 rounded">Program.cs</code>: <code class="bg-muted px-1 rounded">builder.Services.AddHttpContextAccessor();</code></p>
    </div>

    <div class="p-6 rounded-3xl bg-card border border-border">
        <h2 class="font-semibold text-foreground mb-1">Basic Usage</h2>
        <p class="text-sm text-muted-foreground mb-4">Start using components in your pages.</p>
        <pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>&lt;WaxButton Variant="WaxButtonVariant.Filled"
          Size="WaxButtonSize.Medium"&gt;
    &lt;ChildContent&gt;Click me&lt;/ChildContent&gt;
&lt;/WaxButton&gt;

&lt;WaxBadge Color="WaxColor.Primary"&gt;New&lt;/WaxBadge&gt;

&lt;WaxSwitch Label="Dark mode" /&gt;</code></pre>
    </div>

</div>
