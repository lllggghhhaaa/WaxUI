@using System.Globalization
@using LucideBlazor
@using WaxComponents.Utils

@inherits WaxComponent

<div class="@WrapperClass" style="@Style" @onkeydown="OnKeyDown" @attributes="AdditionalAttributes">
    <p class="mb-2 font-mono text-xs text-muted-foreground">@Label.ToUpperInvariant()</p>

    <div class="relative">
        <button @ref="_triggerRef"
                type="button"
                class="@TriggerClass"
                disabled="@Disabled"
                aria-haspopup="dialog"
                aria-expanded="@(_open ? "true" : "false")"
                @onclick="ToggleOpen">
            <LucideIcon Name="calendar-days" Size="17" ClassName="shrink-0 text-primary" />
            <span class="@ValueClass">@Caption</span>
            <LucideIcon Name="chevron-down" Size="15" ClassName="@ChevronClass" />
        </button>

        @if (_open)
        {
            <div class="fixed inset-0 z-20" aria-hidden="true" @onclick="Close"></div>

            <div role="dialog" aria-label="@($"{Label} calendar")" class="@PanelClass">
                <div class="flex items-center justify-between px-1 pb-2">
                    <button type="button" class="@NavButtonClass" aria-label="Previous month" @onclick="() => ShiftMonth(-1)">
                        <LucideIcon Name="chevron-left" Size="16" />
                    </button>
                    <p class="font-display text-base font-semibold text-foreground">@MonthLabel</p>
                    <button type="button" class="@NavButtonClass" aria-label="Next month" @onclick="() => ShiftMonth(1)">
                        <LucideIcon Name="chevron-right" Size="16" />
                    </button>
                </div>

                <div class="grid grid-cols-7">
                    @foreach (var name in WeekdayHeaders)
                    {
                        <div class="py-1.5 text-center font-mono text-xs text-muted-foreground">@name</div>
                    }
                </div>

                <div class="grid grid-cols-7 gap-y-1">
                    @foreach (var day in GridDays)
                    {
                        <button type="button"
                                class="@DayClass(day)"
                                disabled="@IsDisabled(day)"
                                aria-pressed="@(IsSelected(day) ? "true" : "false")"
                                aria-label="@day.ToString("D", Culture)"
                                @onclick="() => SelectAsync(day)">
                            @day.Day
                        </button>
                    }
                </div>

                @if (Clearable && CurrentDate is not null)
                {
                    <button type="button"
                            class="mt-2 w-full cursor-pointer rounded-full px-3 py-2 text-xs font-semibold text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                            @onclick="ClearAsync">
                        Clear date
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    private ElementReference _triggerRef;
    private DateTime? _value;
    private DateTime _viewMonth;
    private bool _open;

    /// <summary>Selected date; bind with <c>@bind-Value</c> to control it.</summary>
    [Parameter] public DateTime? Value { get; set; }

    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }

    /// <summary>Initial date when <see cref="Value"/> is unbound.</summary>
    [Parameter] public DateTime? DefaultValue { get; set; }

    /// <summary>Uppercase field label shown above the trigger.</summary>
    [Parameter] public string Label { get; set; } = "Date";

    [Parameter] public string Placeholder { get; set; } = "Choose a date";

    /// <summary>.NET format string for the selected date.</summary>
    [Parameter] public string DateFormat { get; set; } = "MMM d, yyyy";

    /// <summary>Earliest selectable date, inclusive.</summary>
    [Parameter] public DateTime? MinDate { get; set; }

    /// <summary>Latest selectable date, inclusive.</summary>
    [Parameter] public DateTime? MaxDate { get; set; }

    /// <summary>Allows dates before today; off by default, like the reference design.</summary>
    [Parameter] public bool AllowPastDates { get; set; }

    /// <summary>Shows the "Clear date" action while a date is selected.</summary>
    [Parameter] public bool Clearable { get; set; } = true;

    [Parameter] public bool Disabled { get; set; }

    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    private DateTime Today => DateTime.Today;

    private DateTime? CurrentDate => (ValueChanged.HasDelegate ? Value : _value)?.Date;

    private DayOfWeek FirstDayOfWeek => Culture.DateTimeFormat.FirstDayOfWeek;

    private DateTime MonthStart => new(_viewMonth.Year, _viewMonth.Month, 1);

    private int DaysInMonth => DateTime.DaysInMonth(_viewMonth.Year, _viewMonth.Month);

    private int LeadingDays => ((int)MonthStart.DayOfWeek - (int)FirstDayOfWeek + 7) % 7;

    private int WeekCount => (LeadingDays + DaysInMonth + 6) / 7;

    private IEnumerable<DateTime> GridDays =>
        Enumerable.Range(0, WeekCount * 7).Select(offset => MonthStart.AddDays(offset - LeadingDays));

    private IEnumerable<string> WeekdayHeaders
    {
        get
        {
            var names = Culture.DateTimeFormat.ShortestDayNames;
            return Enumerable.Range(0, 7).Select(offset => names[((int)FirstDayOfWeek + offset) % 7]);
        }
    }

    private string Caption => CurrentDate is { } date ? date.ToString(DateFormat, Culture) : Placeholder;

    private string MonthLabel => _viewMonth.ToString("MMMM yyyy", Culture);

    private string WrapperClass => "relative w-full sm:w-auto".MergeClass(Class);

    private string TriggerClass =>
        "flex w-full cursor-pointer items-center gap-3 rounded-2xl border bg-background px-4 py-3 text-left text-sm transition-colors sm:min-w-56"
            .MergeClass(
                _open ? "border-primary ring-2 ring-primary/15" : "border-border hover:border-primary/40",
                Disabled ? "cursor-not-allowed opacity-60" : string.Empty);

    private string ValueClass => "min-w-0 flex-1 truncate"
        .MergeClass(CurrentDate is null ? "text-muted-foreground" : "font-medium text-foreground");

    private string ChevronClass => "shrink-0 text-muted-foreground transition-transform duration-200"
        .MergeClass(_open ? "rotate-180" : string.Empty);

    private string PanelClass =>
        "absolute right-0 z-30 mt-2 w-[19rem] max-w-[calc(100vw-2rem)] rounded-3xl border border-border bg-popover p-3 text-popover-foreground shadow-xl";

    private const string NavButtonClass =
        "flex h-8 w-8 cursor-pointer items-center justify-center rounded-xl text-muted-foreground transition-colors hover:bg-muted hover:text-foreground";

    protected override void OnInitialized()
    {
        _value = (ValueChanged.HasDelegate ? Value : DefaultValue)?.Date;
        _viewMonth = StartOfMonth(CurrentDate ?? Today);
    }

    private static DateTime StartOfMonth(DateTime date) => new(date.Year, date.Month, 1);

    private bool IsSelected(DateTime day) => CurrentDate is { } date && date == day.Date;

    private bool IsToday(DateTime day) => day.Date == Today;

    private bool IsDisabled(DateTime day)
    {
        var date = day.Date;

        if (MinDate is { } min && date < min.Date) return true;
        if (MaxDate is { } max && date > max.Date) return true;

        return !AllowPastDates && date < Today;
    }

    private string DayClass(DateTime day)
    {
        const string baseClass = "flex h-10 w-10 items-center justify-center rounded-xl text-sm transition-colors";

        if (IsDisabled(day))
        {
            return baseClass.MergeClass("cursor-not-allowed text-muted-foreground/30 line-through");
        }

        if (IsSelected(day))
        {
            return baseClass.MergeClass("cursor-pointer bg-primary font-medium text-primary-foreground hover:bg-primary/90");
        }

        var classes = baseClass.MergeClass(
            day.Month == _viewMonth.Month
                ? "cursor-pointer text-foreground hover:bg-muted"
                : "cursor-pointer text-muted-foreground/40 hover:bg-muted hover:text-foreground");

        return IsToday(day) ? classes.MergeClass("font-bold text-primary ring-1 ring-primary/30") : classes;
    }

    private void ToggleOpen()
    {
        if (Disabled)
        {
            return;
        }

        if (_open)
        {
            Close();
            return;
        }

        _viewMonth = StartOfMonth(CurrentDate ?? Today);
        _open = true;
    }

    private void Close() => _open = false;

    private void ShiftMonth(int delta) => _viewMonth = MonthStart.AddMonths(delta);

    private async Task SelectAsync(DateTime day)
    {
        if (IsDisabled(day))
        {
            return;
        }

        var date = day.Date;
        _value = date;
        _open = false;

        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(date);
        }

        await _triggerRef.FocusAsync();
    }

    private async Task ClearAsync()
    {
        _value = null;
        _open = false;

        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(null);
        }

        await _triggerRef.FocusAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || !_open)
        {
            return;
        }

        Close();
        await _triggerRef.FocusAsync();
    }
}
