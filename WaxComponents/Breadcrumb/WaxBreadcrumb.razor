@using LucideBlazor
@using WaxComponents.Utils

@inherits WaxComponent

<nav aria-label="@AriaLabel" class="@CssClass" style="@Style" @attributes="AdditionalAttributes">
    <ol class="flex flex-wrap items-center gap-1.5">
        @for (var index = 0; index < Items.Count; index++)
        {
            var item = Items[index];
            var isCurrent = index == Items.Count - 1;

            <li class="flex items-center gap-1.5">
                @if (index > 0)
                {
                    <LucideIcon Name="chevron-right" Size="13" ClassName="shrink-0 text-muted-foreground/60" />
                }

                @if (isCurrent)
                {
                    <span class="font-semibold text-foreground" aria-current="page">
                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <LucideIcon Name="@item.Icon" Size="13" ClassName="mr-1 inline shrink-0" />
                        }
                        @item.Label
                    </span>
                }
                else if (!string.IsNullOrEmpty(item.Href))
                {
                    <a href="@item.Href" class="@LinkClass">
                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <LucideIcon Name="@item.Icon" Size="13" ClassName="mr-1 inline shrink-0" />
                        }
                        @item.Label
                    </a>
                }
                else if (OnItemClick.HasDelegate)
                {
                    <button type="button" class="@LinkClass" @onclick="() => OnItemClick.InvokeAsync(item)">
                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <LucideIcon Name="@item.Icon" Size="13" ClassName="mr-1 inline shrink-0" />
                        }
                        @item.Label
                    </button>
                }
                else
                {
                    <span>
                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <LucideIcon Name="@item.Icon" Size="13" ClassName="mr-1 inline shrink-0" />
                        }
                        @item.Label
                    </span>
                }
            </li>
        }
    </ol>
</nav>

@code {
    /// <summary>Trail of crumbs. The last item is rendered as the current page.</summary>
    [Parameter, EditorRequired] public List<WaxBreadcrumbItem> Items { get; set; } = [];

    /// <summary>Accessible label for the surrounding nav element.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Breadcrumb";

    /// <summary>Raised when a crumb without an Href is clicked, so the caller can navigate itself.</summary>
    [Parameter] public EventCallback<WaxBreadcrumbItem> OnItemClick { get; set; }

    private string CssClass =>
        "flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground".MergeClass(Class);

    private const string LinkClass =
        "cursor-pointer border-0 bg-transparent p-0 text-xs text-muted-foreground no-underline transition-colors hover:text-foreground hover:underline";
}
