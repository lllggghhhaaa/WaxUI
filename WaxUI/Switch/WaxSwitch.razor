@using LucideBlazor
@using WaxUI.Utils

@inherits WaxComponent

<label class="@LabelClassCss" style="@Style" @attributes="AdditionalAttributes">
    @if (Interactive)
    {
        <button type="button"
                role="switch"
                aria-checked="@Value.ToString().ToLowerInvariant()"
                disabled="@Disabled"
                @onclick="HandleClick"
                class="@TrackClassCss">
            <span class="@ThumbClassCss">
                @if (Value && ShowCheck)
                {
                    <LucideIcon Size="@CheckSize" Name="check" ClassName="text-primary" StrokeWidth="3" />
                }
            </span>
        </button>
    }
    else
    {
        <span role="presentation" aria-hidden="true" class="@TrackClassCss">
            <span class="@ThumbClassCss">
                @if (Value && ShowCheck)
                {
                    <LucideIcon Size="@CheckSize" Name="check" ClassName="text-primary" StrokeWidth="3" />
                }
            </span>
        </span>
    }
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="text-sm font-medium text-foreground">@Label</span>
    }
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public WaxSwitchSize Size { get; set; } = WaxSwitchSize.Large;

    /// <summary>False renders a pure display switch (no button element, no click handling) for rows that own the interaction.</summary>
    [Parameter] public bool Interactive { get; set; } = true;

    /// <summary>Renders the check glyph inside the thumb while on (pass false for minimal toggles).</summary>
    [Parameter] public bool ShowCheck { get; set; } = true;

    [Parameter] public string TrackClass { get; set; } = string.Empty;

    [Parameter] public string ThumbClass { get; set; } = string.Empty;

    private async Task HandleClick()
    {
        if (Disabled) return;

        Value = !Value;
        await ValueChanged.InvokeAsync(Value);
    }

    private string LabelClassCss =>
        Cn.Of("inline-flex items-center gap-3",
            Interactive && Disabled ? "cursor-not-allowed opacity-40" : Interactive ? "cursor-pointer" : null,
            Class).Value;

    private string TrackClassCss =>
        Cn.Of("relative shrink-0 rounded-full transition-all duration-300",
            TrackSize,
            Value ? "bg-primary" : "bg-switch-background",
            Interactive && Disabled ? "pointer-events-none" : null,
            TrackClass).Value;

    private string ThumbClassCss =>
        Cn.Of("absolute flex items-center justify-center rounded-full bg-background shadow-sm transition-all duration-300",
            ThumbSize, ThumbPosition, ThumbClass).Value;

    private KhamsinClass TrackSize => Kx.Variant(Size,
        (WaxSwitchSize.Small, "w-9 h-5"),
        (WaxSwitchSize.Medium, "w-10 h-6"),
        (WaxSwitchSize.Normal, "w-12 h-7"),
        (WaxSwitchSize.Large, "w-14 h-7"));

    private KhamsinClass ThumbSize => Kx.Variant(Size,
        (WaxSwitchSize.Small, "w-4 h-4"),
        (WaxSwitchSize.Medium, "w-5 h-5"),
        (WaxSwitchSize.Normal, "w-5 h-5"),
        (WaxSwitchSize.Large, "w-5 h-5"));

    private KhamsinClass ThumbPosition => (Size, Value) switch
    {
        (WaxSwitchSize.Small, false) => Cn.Of("top-0.5 left-0.5"),
        (WaxSwitchSize.Small, true) => Cn.Of("top-0.5 left-[18px]"),
        (WaxSwitchSize.Medium, false) => Cn.Of("top-0.5 left-0.5"),
        (WaxSwitchSize.Medium, true) => Cn.Of("top-0.5 left-[18px]"),
        (WaxSwitchSize.Normal, false) => Cn.Of("top-1 left-1"),
        (WaxSwitchSize.Normal, true) => Cn.Of("top-1 left-6"),
        (WaxSwitchSize.Large, false) => Cn.Of("top-1 left-1"),
        (WaxSwitchSize.Large, true) => Cn.Of("top-1 left-8"),
        _ => KhamsinClass.Empty,
    };

    private int CheckSize => Size == WaxSwitchSize.Small ? 8 : 10;
}
