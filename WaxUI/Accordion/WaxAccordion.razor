@using LucideBlazor
@using WaxUI.Utils

@inherits WaxComponent

<div class="@CssClass" style="@Style" @attributes="AdditionalAttributes">
    @if (Items is not null)
    {
        var index = 0;
        foreach (var item in Items)
        {
            var i = index;
            var isOpen = _openIndex == i;
            <div class="@Cn.Of("transition-colors duration-200", (isOpen, "bg-card", "bg-background hover:bg-muted/40")).Value">
                <button @onclick="() => Toggle(i)"
                        class="w-full flex items-center justify-between gap-4 px-6 py-4 text-left cursor-pointer">
                    <div class="flex items-center gap-3">
                        @if (item.Icon != null)
                        {
                            <span class="@Cn.Of("shrink-0 transition-colors", (isOpen, "text-primary", "text-muted-foreground")).Value">
                                @item.Icon
                            </span>
                        }
                        <span class="@Cn.Of("font-medium transition-colors", (isOpen, "text-primary", "text-foreground")).Value">
                            @item.Title
                        </span>
                    </div>
                    <LucideIcon Name="chevron-down" ClassName="@Cn.Of("shrink-0 text-muted-foreground transition-transform duration-300", (isOpen, "rotate-180")).Value" />
                </button>
                <div class="@BodyClass(isOpen)">
                    @* The direct child is the collapsing grid item: it must carry no padding of
                       its own, or the 0fr track stops at the padding instead of collapsing to
                       zero. Padding lives on the paragraph inside it. *@
                    <div class="min-h-0 overflow-hidden">
                        <p class="@Cn.Of("px-6 pb-5 text-sm text-muted-foreground leading-relaxed transition-opacity duration-300", (isOpen, "opacity-100", "opacity-0")).Value">
                            @item.Body
                        </p>
                    </div>
                </div></div>
            index++;
        }
    }
</div>

@code {
    [Parameter] public List<WaxAccordionItemData>? Items { get; set; }
    [Parameter] public int DefaultOpenIndex { get; set; }

    private string CssClass => Cn.Of("divide-y divide-border rounded-3xl overflow-hidden border border-border", Class).Value;

    // Marker classes for the grid-rows height animation live in app.css; concatenated
    // outside Cn.Of because Khamsin only knows utilities (same pattern as .wax-transition-filter).
    private static string BodyClass(bool isOpen) =>
        "wax-accordion-body" + (isOpen ? " wax-accordion-open" : string.Empty);

    private int? _openIndex;

    protected override void OnInitialized()
    {
        _openIndex = Items?.Count > 0 ? DefaultOpenIndex : null;
    }

    private void Toggle(int index) => _openIndex = _openIndex == index ? null : index;
}