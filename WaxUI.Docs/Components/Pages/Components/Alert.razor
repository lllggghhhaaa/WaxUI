@page "/component/alert"
@rendermode InteractiveServer
@using WaxUI.Alert
@using WaxUI.Button
@using WaxUI.Tabs
@inject IWaxAlertService Alerts

<PageTitle>Alert - WaxUI</PageTitle>

<div class="mb-8">
    <h1 class="text-3xl font-display font-bold text-foreground mb-2">Alert</h1>
    <p class="text-muted-foreground">Inline messages for feedback, warnings, and status updates. The alert service adds transient, stacked notifications through a <code>WaxAlertOutlet</code>.</p>
</div>

<div class="space-y-6">
    <div class="p-6 rounded-3xl bg-card border border-border">
        <h3 class="font-semibold text-foreground mb-1">Severities</h3>
        <WaxTab Variant="WaxTabVariant.Primary" Tabs="_severityTabs" TabListClass="mb-4" />
    </div>

    <div class="p-6 rounded-3xl bg-card border border-border">
        <h3 class="font-semibold text-foreground mb-1">With Actions</h3>
        <WaxTab Variant="WaxTabVariant.Primary" Tabs="_actionTabs" TabListClass="mb-4" />
    </div>

    <div class="p-6 rounded-3xl bg-card border border-border">
        <h3 class="font-semibold text-foreground mb-1">Custom Icon</h3>
        <WaxTab Variant="WaxTabVariant.Primary" Tabs="_iconTabs" TabListClass="mb-4" />
    </div>

    <div class="p-6 rounded-3xl bg-card border border-border">
        <h3 class="font-semibold text-foreground mb-1">Spoiler</h3>
        <WaxTab Variant="WaxTabVariant.Primary" Tabs="_spoilerTabs" TabListClass="mb-4" />
    </div>

    <div class="p-6 rounded-3xl bg-card border border-border">
        <h3 class="font-semibold text-foreground mb-1">From Code (Service)</h3>
        <p class="mb-3 text-[13px] text-muted-foreground">IWaxAlertService shows transient or persistent alerts from anywhere in the interactive tree. Alerts auto-dismiss after five seconds unless a different duration (or null) is set. Requires a WaxAlertOutlet in the layout.</p>
        <WaxTab Variant="WaxTabVariant.Primary" Tabs="_serviceTabs" TabListClass="mb-4" />
    </div>
</div>

@code {
    private static List<WaxTabItem> _severityTabs =
    [
        new("Preview", Content: @<div class="space-y-3">
            <WaxAlert Severity="WaxAlertSeverity.Destructive" Message="Something went wrong. Please try again." />
            <WaxAlert Severity="WaxAlertSeverity.Success" Message="Your changes have been saved." />
            <WaxAlert Severity="WaxAlertSeverity.Info" Message="A new version is available." />
            <WaxAlert Severity="WaxAlertSeverity.Warning" Message="Your session expires in 5 minutes." />
        </div>, Icon: "monitor-dot"),
        new("Code", Content: @<pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>@_severityCode</code></pre>, Icon: "code")
    ];

    private static List<WaxTabItem> _actionTabs =
    [
        new("Preview", Content: @<div class="space-y-3">
            <WaxAlert Severity="WaxAlertSeverity.Warning" Message="Your session expires in 5 minutes.">
                <div class="mt-2 flex items-center gap-2">
                    <WaxButton Variant="WaxButtonVariant.Text" Size="WaxButtonSize.Small">Renew session</WaxButton>
                </div>
            </WaxAlert>
            <WaxAlert Severity="WaxAlertSeverity.Destructive" Message="The upload failed.">
                <div class="mt-2 flex items-center gap-2">
                    <WaxButton Variant="WaxButtonVariant.Text" Size="WaxButtonSize.Small">Retry</WaxButton>
                </div>
            </WaxAlert>
        </div>, Icon: "monitor-dot"),
        new("Code", Content: @<pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>@_actionCode</code></pre>, Icon: "code")
    ];

    private static List<WaxTabItem> _iconTabs =
    [
        new("Preview", Content: @<div class="space-y-3">
            <WaxAlert Severity="WaxAlertSeverity.Info" Icon="rocket" Message="Deployment finished in 42 seconds." />
            <WaxAlert Severity="WaxAlertSeverity.Success" Icon="party-popper" Message="Welcome to the workspace!" />
        </div>, Icon: "monitor-dot"),
        new("Code", Content: @<pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>@_iconCode</code></pre>, Icon: "code")
    ];

    private static List<WaxTabItem> _spoilerTabs =
    [
        new("Preview", Content: @<div class="space-y-3">
            <WaxAlert Severity="WaxAlertSeverity.Warning" Message="Your temporary password is wax-7f3k-99dx." Spoiler="true" />
            <WaxAlert Severity="WaxAlertSeverity.Info" Message="The migration finished at 03:14 with 0 errors." Spoiler="true" />
        </div>, Icon: "monitor-dot"),
        new("Code", Content: @<pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>@_spoilerCode</code></pre>, Icon: "code")
    ];

    private List<WaxTabItem> _serviceTabs = [];

    protected override void OnInitialized()
    {
        _serviceTabs =
        [
            new("Preview", Content: @<div class="space-y-3">
                <div class="flex flex-wrap gap-2">
                    <WaxButton Variant="WaxButtonVariant.Outlined" OnClick="ShowSuccess">Success</WaxButton>
                    <WaxButton Variant="WaxButtonVariant.Outlined" OnClick="ShowError">Error</WaxButton>
                    <WaxButton Variant="WaxButtonVariant.Tonal" OnClick="ShowPersistent">Persistent warning</WaxButton>
                    <WaxButton Variant="WaxButtonVariant.Text" OnClick="ClearAlerts">Clear all</WaxButton>
                </div>
                <p class="mb-0 text-sm text-muted-foreground">Alerts stack in the outlet — try opening several at once.</p>
            </div>, Icon: "monitor-dot"),
            new("Code", Content: @<pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>@_serviceCode</code></pre>, Icon: "code")
        ];
    }

    private void ShowSuccess() => Alerts.Success("Your changes have been saved.");

    private void ShowError() => Alerts.Error("The upload failed. Please try again.");

    private void ShowPersistent() => Alerts.Show(new WaxAlertOptions
    {
        Severity = WaxAlertSeverity.Warning,
        Message = "Your session expires in 5 minutes.",
        Duration = null,
    });

    private void ClearAlerts() => Alerts.Clear();

    private static string _severityCode = """
        @using WaxUI.Alert

        <div class="space-y-3">
            <WaxAlert Severity="WaxAlertSeverity.Destructive" Message="Something went wrong. Please try again." />
            <WaxAlert Severity="WaxAlertSeverity.Success" Message="Your changes have been saved." />
            <WaxAlert Severity="WaxAlertSeverity.Info" Message="A new version is available." />
            <WaxAlert Severity="WaxAlertSeverity.Warning" Message="Your session expires in 5 minutes." />
        </div>
        """;

    private static string _actionCode = """
        @using WaxUI.Alert
        @using WaxUI.Button

        <WaxAlert Severity="WaxAlertSeverity.Warning" Message="Your session expires in 5 minutes.">
            <div class="mt-2 flex items-center gap-2">
                <WaxButton Variant="WaxButtonVariant.Text" Size="WaxButtonSize.Small">Renew session</WaxButton>
            </div>
        </WaxAlert>
        """;

    private static string _iconCode = """
        @using WaxUI.Alert

        <WaxAlert Severity="WaxAlertSeverity.Info" Icon="rocket" Message="Deployment finished in 42 seconds." />
        """;

    private static string _spoilerCode = """
        @using WaxUI.Alert

        <WaxAlert Severity="WaxAlertSeverity.Warning" Message="Your temporary password is wax-7f3k-99dx." Spoiler="true" />
        <WaxAlert Severity="WaxAlertSeverity.Info" Message="The migration finished at 03:14 with 0 errors." Spoiler="true" />
        """;

    private static string _serviceCode = """
        @using WaxUI.Alert
        @inject IWaxAlertService Alerts

        <WaxButton OnClick="ShowSuccess">Success</WaxButton>
        <WaxButton OnClick="ShowError">Error</WaxButton>

        @code {
            private void ShowSuccess() =>
                Alerts.Success("Your changes have been saved.");

            private void ShowError() =>
                Alerts.Error("The upload failed. Please try again.");

            private void ShowPersistent() =>
                Alerts.Show(new WaxAlertOptions
                {
                    Severity = WaxAlertSeverity.Warning,
                    Message = "Your session expires in 5 minutes.",
                    Duration = null, // keep open until dismissed
                });
        }
        """;
}
