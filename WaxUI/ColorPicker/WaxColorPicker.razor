@using LucideBlazor
@inherits WaxColorPickerBase

<div class="@WrapperClass" style="@Style" @attributes="AdditionalAttributes">
    @if (Name is { Length: > 0 })
    {
        <input type="hidden" name="@Name" value="@CurrentValue" />
    }

    @if (Variant != WaxColorPickerVariant.Inline)
    {
        <button type="button"
                class="@TriggerClass"
                disabled="@Disabled"
                aria-haspopup="dialog"
                aria-expanded="@Aria(IsOpen)"
                aria-label="@($"{Label}: {FormattedValue}")"
                @onclick="ToggleOpenAsync"
                @onkeydown="OnTriggerKeyDownAsync"
                @ref="_triggerRef">
            <span class="@TriggerSwatchClass" style="@TriggerSwatchStyle"></span>
            @if (Variant == WaxColorPickerVariant.Popover)
            {
                <span class="min-w-0 flex-1 truncate font-medium tracking-tight">@FormattedValue</span>
                <LucideIcon Name="chevron-down" Size="16" ClassName="@TriggerChevronClass" />
            }
        </button>

        @if (IsOpen)
        {
            <div class="@WaxColorPickerStyles.ClickAway" aria-hidden="true" @onclick="CloseOpenAsync"></div>
        }
    }

    @if (PanelVisible)
    {
        <fieldset class="@PanelClass"
                  role="@(Variant == WaxColorPickerVariant.Inline ? null : "dialog")"
                  aria-label="@Label"
                  disabled="@Disabled"
                  @onkeydown="OnPanelKeyDownAsync">

            @if (Presets is not null)
            {
                <WaxColorPickerPresets Values="@Presets"
                                       SwatchShape="@SwatchShape"
                                       OnSelect="SelectPresetAsync" />
            }

            <WaxColorPickerPalette Hue="@_pickerH"
                                   Saturation="@_pickerS"
                                   Value="@_pickerV"
                                   Alpha="@_alpha"
                                   ShowAlpha="@ShowAlpha"
                                   Disabled="@Disabled"
                                   OnInput="OnPaletteInputAsync"
                                   OnCommit="OnPaletteCommitAsync"
                                   OnEditingChanged="SetEditing" />

            <WaxColorPickerFooter Format="@Format"
                                  Disabled="@Disabled"
                                  ShowCopy="@ShowCopy"
                                  ShowEyedropper="@ShowEyedropper"
                                  CopyValue="@FormattedValue"
                                  FormatChanged="SelectFormatAsync"
                                  EyedropperPicked="OnEyedropperPickedAsync"
                                  OnEyedropperUnsupported="OnEyedropperUnsupported" />

            <div class="relative z-10 mt-2 flex items-start gap-2 text-foreground">
                @if (Format == WaxColorPickerFormat.Hex)
                {
                    <div class="@WaxColorPickerStyles.HexField">
                        <div class="flex min-w-0 items-center justify-center gap-1.5">
                            <span class="@SwatchClass("h-5 w-5")" style="@($"background-color: {ColorValue}")"></span>
                            <div class="flex min-w-0 items-center justify-center gap-0.5">
                                <span class="shrink-0 text-base font-light text-muted-foreground">#</span>
                                <input type="text"
                                       spellcheck="false"
                                       class="@HexInputClass"
                                       disabled="@Disabled"
                                       aria-label="Hex color"
                                       value="@HexDisplayValue"
                                       @ref="_hexInputRef"
                                       @onfocus="OnHexFocus"
                                       @oninput="OnHexInputAsync"
                                       @onblur="OnHexBlurAsync"
                                       @onkeydown="OnHexKeyDownAsync" />
                            </div>
                        </div>
                        @if (_hexInvalid)
                        {
                            <p class="mt-1 text-xs text-destructive">Enter a valid hex color.</p>
                        }
                    </div>
                }
                else
                {
                    @foreach (var channel in FormatChannels())
                    {
                        @ChannelTemplate(channel)
                    }
                }

                @if (ShowAlpha)
                {
                    @ChannelTemplate(AlphaChannel)
                }
            </div>
        </fieldset>
    }
</div>

@code {
    private RenderFragment<Channel> ChannelTemplate => channel =>
        @<WaxColorChannelInput @key="channel.Label"
                               Label="@channel.Label"
                               Suffix="@channel.Suffix"
                               Min="0"
                               Max="@channel.Max"
                               Disabled="@Disabled"
                               Value="@channel.Value"
                               ValueChanged="@channel.OnChange"
                               OnEditStart="BeginEdit"
                               OnEditEnd="EndEdit" />;

    protected override string CurrentValue => ColorValue;

    /// <summary>A gradient value collapses to its first stop's color; anything else must be hex.</summary>
    protected override void LoadSource(string source)
    {
        if (WaxGradientMath.ParseGradient(source) is { } gradient)
        {
            var first = WaxGradientMath.FirstStop(gradient.Stops);
            SetSolidColor(first.Rgb, ShowAlpha ? first.AlphaPercent : 100);
            return;
        }

        var parsed = WaxColorMath.ParseHexColor(source) ?? new WaxColorMath.ParsedHexColor(WaxColorMath.DefaultRgb, null);
        SetSolidColor(parsed.Rgb, ShowAlpha ? parsed.AlphaPercent ?? WaxColorMath.ClampPercent(DefaultAlpha) : 100);
    }
}
