@using LucideBlazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using WaxComponents.Utils

@inherits WaxComponent
@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="@WrapperClass" style="@Style" @attributes="AdditionalAttributes">
    <div class="mb-2 flex items-center justify-between gap-3">
        <p class="font-mono text-xs text-muted-foreground">@Label.ToUpperInvariant()</p>
        @if (CurrentFile is not null)
        {
            <button type="button" class="@RemoveClass" disabled="@Disabled" @onclick="RemoveAsync">
                Remove
            </button>
        }
    </div>

    <div @ref="_zoneRef" class="@ZoneClass" aria-disabled="@Disabled">
        <InputFile class="sr-only"
                   accept="@Accept"
                   tabindex="-1"
                   aria-hidden="true"
                   OnChange="HandleFileChangeAsync" />

        @if (CurrentFile is not null)
        {
            <div class="flex items-center gap-3">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-secondary/15 text-secondary">
                    <LucideIcon Name="@FileIcon" Size="21" />
                </div>
                <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-semibold">@CurrentFile.Name</p>
                    <p class="font-mono text-xs text-muted-foreground">@WaxFileDrop.FormatSize(CurrentFile.Size) · Ready to upload</p>
                </div>
                <LucideIcon Name="check" Size="18" ClassName="shrink-0 text-secondary" />
            </div>
        }
        else
        {
            <div class="flex flex-col items-center py-3 text-center">
                <div class="@IconBubbleClass">
                    <LucideIcon Name="cloud-upload" Size="22" />
                </div>
                <p class="mt-3 text-sm font-semibold">@(IsDragging ? "Drop it right here" : "Drag and drop your file")</p>
                <p class="mt-1 text-xs text-muted-foreground">@DescriptionText</p>
                <button type="button" class="@BrowseClass" disabled="@Disabled" @onclick="OpenPickerAsync">
                    Browse files
                </button>
            </div>
        }
    </div>

    @if (_error is not null)
    {
        <p class="mt-2 text-xs font-medium text-destructive" role="alert">@_error</p>
    }
</div>

@code {
    private ElementReference _zoneRef;
    private WaxDropJs? _jsInterop;
    private DotNetObjectReference<WaxDropzone>? _selfRef;
    private IBrowserFile? _file;
    private string? _error;
    private bool _dragging;
    private bool _attached;

    /// <summary>Uppercase field label shown above the zone.</summary>
    [Parameter] public string Label { get; set; } = "Upload";

    /// <summary>Hint under the headline; defaults to the accepted formats and size limit.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Comma-separated MIME types or extensions, also used for the browse dialog.</summary>
    [Parameter] public string Accept { get; set; } = "image/png,image/jpeg,image/webp";

    /// <summary>Largest accepted file in bytes (defaults to 5 MB). Zero disables the check.</summary>
    [Parameter] public long MaxSize { get; set; } = 5 * 1024 * 1024;

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Fires with the accepted file; read it with <c>OpenReadStream</c>.</summary>
    [Parameter] public EventCallback<IBrowserFile> OnFileSelected { get; set; }

    /// <summary>Fires when the chosen file is cleared.</summary>
    [Parameter] public EventCallback OnRemoved { get; set; }

    private IBrowserFile? CurrentFile => _file;

    private bool IsDragging => _dragging;

    private string DescriptionText => Description
        ?? (string.IsNullOrWhiteSpace(WaxFileDrop.DescribeAccept(Accept))
            ? $"Up to {WaxFileDrop.FormatSize(MaxSize)}"
            : $"{WaxFileDrop.DescribeAccept(Accept)} up to {WaxFileDrop.FormatSize(MaxSize)}");

    private string FileIcon => CurrentFile?.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true
        ? "image"
        : "file";

    private string WrapperClass => "block".MergeClass(Class);

    private string ZoneClass => "rounded-3xl border-2 border-dashed p-4 transition-colors"
        .MergeClass(
            _dragging
                ? "border-primary bg-primary/10"
                : _error is not null
                    ? "border-destructive/50 bg-destructive/5"
                    : "border-border bg-background",
            Disabled ? "pointer-events-none opacity-60" : string.Empty);

    private string IconBubbleClass => "flex h-12 w-12 items-center justify-center rounded-2xl"
        .MergeClass(_dragging ? "bg-primary text-primary-foreground" : "bg-primary/10 text-primary");

    private const string BrowseClass =
        "mt-3 rounded-full border border-primary px-4 py-2 text-xs font-semibold text-primary transition-colors hover:bg-primary/10 disabled:opacity-60";

    private const string RemoveClass =
        "text-xs font-semibold text-destructive transition-colors hover:underline disabled:opacity-60";

    private DotNetObjectReference<WaxDropzone> SelfRef => _selfRef ??= DotNetObjectReference.Create(this);

    [JSInvokable]
    public Task OnDragStateChanged(bool dragging)
    {
        if (_dragging == dragging)
        {
            return Task.CompletedTask;
        }

        _dragging = dragging;
        return InvokeAsync(StateHasChanged);
    }

    private Task OpenPickerAsync() => _jsInterop is null
        ? Task.CompletedTask
        : _jsInterop.InvokeAsync<object?>("openPicker", _zoneRef);

    private async Task HandleFileChangeAsync(InputFileChangeEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        if (e.FileCount != 1)
        {
            _file = null;
            _error = "Drop a single file.";
            return;
        }

        var file = e.File;
        var error = WaxFileDrop.Validate(file, Accept, MaxSize);

        if (error is not null)
        {
            _file = null;
            _error = error;
            _dragging = false;
            return;
        }

        _file = file;
        _error = null;
        _dragging = false;

        await OnFileSelected.InvokeAsync(file);
    }

    private async Task RemoveAsync()
    {
        _file = null;
        _error = null;
        _dragging = false;

        if (_jsInterop is not null)
        {
            await _jsInterop.InvokeAsync<object?>("resetInput", _zoneRef);
        }

        await OnRemoved.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _jsInterop ??= new WaxDropJs(Js);

        if (Disabled && _attached)
        {
            await _jsInterop.InvokeAsync<object?>("detachDropTarget", _zoneRef);
            _attached = false;
        }
        else if (!Disabled && !_attached)
        {
            await _jsInterop.InvokeAsync<object?>("attachDropTarget", _zoneRef, SelfRef);
            _attached = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_attached && _jsInterop is not null)
        {
            _attached = false;
            await _jsInterop.InvokeAsync<object?>("detachDropTarget", _zoneRef);
        }

        _selfRef?.Dispose();

        if (_jsInterop is not null)
        {
            await _jsInterop.DisposeAsync();
        }
    }
}
