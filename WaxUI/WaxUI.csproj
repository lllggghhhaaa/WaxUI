<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Title>WaxUI</Title>
        <Authors>lllggghhhaaaa</Authors>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/lllggghhhaaa/WaxUI</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>blazor</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageVersion>0.10.0</PackageVersion>
        <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoRoot>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="" />
        <PackageReference Include="Khamsin" Version="0.3.0" />
        <!-- Project configuration, not consumer content. khamsin.json is embedded in the assembly. -->
        <Content Remove="khamsin.json" />
        <Content Remove="package.json" />
        <Content Remove="tsconfig.json" />
    </ItemGroup>

    <!-- Shared npm pipeline bootstrap (TypeScript/esbuild). -->
    <Target Name="NpmInstall" BeforeTargets="BuildScripts"
            Condition="!Exists('$(RepoRoot)node_modules/typescript/package.json') Or !Exists('$(RepoRoot)node_modules/esbuild/package.json')">
        <Exec Command="npm ci --no-audit --no-fund --loglevel=error" WorkingDirectory="$(RepoRoot)" />
    </Target>


    <!-- TypeScript pipeline. Sources in Scripts/, compiled by esbuild: theme.js (ES module
         used by ThemeService), colorPicker.js (ES module used by WaxColorPickerJs),
         dialog.js (ES module used by WaxDialogJs), popover.js (ES module used by
         WaxPopoverJs), dropzone.js (ES module used by WaxDropJs) and
         ThemePreloaderScript.generated.cs (inline <head> script const rendered by
         ThemePreloader.razor, kept inline to avoid a theme flash). -->
    <Target Name="BuildScripts" BeforeTargets="BeforeBuild" DependsOnTargets="NpmInstall">
        <Exec Command="npm run build:js" Condition="'$(Configuration)' != 'Release'" />
        <Exec Command="npm run build:js:min" Condition="'$(Configuration)' == 'Release'" />
        <ItemGroup>
            <!-- Remove+Include so an evaluation-time glob of the generated file is not compiled twice. -->
            <Compile Remove="Services\Theme\ThemePreloaderScript.generated.cs" />
            <Compile Include="Services\Theme\ThemePreloaderScript.generated.cs" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <!-- HttpContext is needed by ThemeCookie (server-rendered <html class> for
         enhanced-navigation theme correctness) and to give docs/apps access. -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="LucideBlazor" Version="1.0.7" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rc.1.26425.128" />
    </ItemGroup>


</Project>
